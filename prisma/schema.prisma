// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  modules  = ["cjs"]
}

datasource db {
  provider = "postgresql"
}

// --- Users / Roles ---
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  emailVerified Boolean @default(false) 
  firstName   String?
  lastName    String?
  phone       String?

  avatarUrl                String?
  avatarStorageKey         String?

  isActive    Boolean  @default(false)
  isAgreedToTerms Boolean  @default(false)
  isAgreedToPrivacyPolicy Boolean  @default(false)

  roles                   UserRole[]
  driverProfile           DriverProfile?
  documents               Document[]
  transportOrders         TransportOrder[] @relation("CreatedByUser")
  assignedTransportOrders TransportOrder[] @relation("AssignedDriver")

  accounts Account[]
  sessions Session[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  // OAuth tokens (optional)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  scope                 String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  // Local auth (email/password) if enabled
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Roles ---

model Role {
  id    String  @id @default(uuid())
  key  String  @unique // 'DRIVER', 'DISPATCHER', 'ACCOUNTANT', 'SPEDITOR'

  users UserRole[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

// --- Driver profile

model DriverProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])

  companyInternalId       String? 
  driverCode              String   @unique 

  visaExpiresAt                 DateTime?
  drivingLicenseExpiresAt       DateTime?
  workPermitExpiresAt           DateTime?
  medicalCheckExpiresAt         DateTime?
  psychCheckExpiresAt           DateTime?
  driverCardExpiresAt           DateTime?
  residenceCardExpiresAt        DateTime?
  driverCertificateExpiresAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([driverCode])
}

// --- Transport Order ---

enum TransportOrderStatus {
  PENDING      
  ACCEPTED     
  IN_PROGRESS  
  LOADING      
  UNLOADING    
  COMPLETED    
  PROBLEM      
}

enum DocumentSource {
  DRIVER      
  DISPATCHER  
  SYSTEM      
}

model TransportOrder {
  id          String   @id @default(cuid())
  ztNumber    String   @unique  
  pwNumber    String?          
  status    TransportOrderStatus @default(PENDING)         

  vehiclePlate      String
  trailerPlate      String?
  driverFirstName   String
  driverLastName    String
  driverPhone       String

  clientName        String     
  contractNumber    String?     
  payerName         String?
  payerVatId        String?
  payerEmail        String?

  fromCountry       String
  toCountry         String
  cargoWeightKg     Float?
  loadingDate       DateTime?
  cargoDescription  String?
  temperatureSensitive Boolean @default(false)
  notes             String?

  createdByUserId   String
  createdByUser     User   @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  assignedDriverUserId String?
  assignedDriver       User?  @relation("AssignedDriver", fields: [assignedDriverUserId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderDocuments OrderDocument[]
    // later: history, statuses, assignments, etc.

  @@index([ztNumber])
  @@index([createdByUserId])
  @@index([assignedDriverUserId])
}

model Document {
  id          String   @id @default(cuid())

  url         String           // pełny URL z Cloudinary / S3
  storageKey  String   @unique // Cloudinary public_id albo S3 key
  mimeType    String           // "image/jpeg", "application/pdf", ...

  sizeBytes       Int?
  originalFilename String?
  description      String?

  uploadedByUserId String?
  uploadedByUser   User? @relation(fields: [uploadedByUserId], references: [id])

  createdAt   DateTime @default(now())

  // relacje „w dół” – jeden model dla wszystkich typów zleceń
  orderLinks  OrderDocument[]

  @@index([uploadedByUserId])
}

model OrderDocument {
  id          String   @id @default(cuid())

  transportOrderId String?
  transportOrder   TransportOrder? @relation(fields: [transportOrderId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  source     DocumentSource @default(DISPATCHER)

  title      String?

  createdAt  DateTime @default(now())

  @@index([transportOrderId])
  @@index([documentId])
}